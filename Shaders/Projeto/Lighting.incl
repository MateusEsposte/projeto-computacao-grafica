
vec3 pointLight(
    vec3 p,
    vec3 viewDir,
    vec3 normal,
    Surface s,
    vec3 lightPos,
    vec3 lightColor,
    float intensity
)
{
    vec3 ld = lightPos - p;
    float distanceToLight = length(ld);
    vec3 l = normalize(ld);

    float attenuation = 1.0 / (
        1.0 + 0.2 * distanceToLight
        + 0.1 * distanceToLight * distanceToLight
    );

    float dif = max(dot(normal, l), 0.0);

    vec3 result = s.color * s.Kd * lightColor
                * dif * attenuation * intensity;

    vec3 reflectDir = reflect(-l, normal);
    float spec = max(dot(viewDir, reflectDir), 0.0);

    result += s.Ks * lightColor
            * pow(spec, 5.0) * attenuation * intensity;

    return result;
}


vec3 spotLight(
    vec3 p,
    vec3 viewDir,
    vec3 normal,
    Surface s,
    vec3 lightPos,
    vec3 lightDir,
    vec3 lightColor,
    float intensity
)
{
    vec3 ld = p - lightPos;
    float distanceToLight = length(ld);

    vec3 l = -normalize(ld);

    // Ângulo entre o feixe e o ponto iluminado
    float cone = dot(normalize(ld), normalize(lightDir));

    // Abertura e suavização do feixe
    float spot = smoothstep(0.65, 0.90, cone);

    // Atenuação pela distância
    float attenuation = 1.0 / (
        1.0 + 0.08 * distanceToLight
        + 0.015 * distanceToLight * distanceToLight
    );

    float dif = max(dot(normal, l), 0.0);

    vec3 result = s.color * s.Kd * lightColor
                * dif * attenuation * spot * intensity;

    vec3 reflectDir = reflect(-l, normal);
    float spec = max(dot(viewDir, reflectDir), 0.0);

    result += s.Ks * lightColor
            * pow(spec, 5.0)
            * attenuation * spot * intensity;

    return result;
}


vec3 streetLights(vec3 p, vec3 viewDir, vec3 normal, Surface s)
{
    vec3 result = vec3(0.0);
    vec3 lightColor = vec3(1.0, 0.82, 0.58);

    result += spotLight(
        p, viewDir, normal, s,
        vec3(-12.0, 4.85, -16.0),
        vec3(0.0, -1.0, -1.0),
        lightColor, 12.0
    );

    result += spotLight(
        p, viewDir, normal, s,
        vec3(14.294, 4.85, -20.354),
        vec3(-0.707, -1.0, 0.707),
        lightColor, 12.0
    );

    result += spotLight(
        p, viewDir, normal, s,
        vec3(25.645, 4.85, -1.387),
        vec3(0.981, -1.0, -0.196),
        lightColor, 12.0
    );

    result += spotLight(
        p, viewDir, normal, s,
        vec3(12.013, 4.85, 14.798),
        vec3(-0.659, -1.0, -0.752),
        lightColor, 12.0
    );

    result += spotLight(
        p, viewDir, normal, s,
        vec3(-13.614, 4.85, 12.476),
        vec3(-0.242, -1.0, 0.970),
        lightColor, 12.0
    );

    result += spotLight(
        p, viewDir, normal, s,
        vec3(-24.468, 4.85, -5.591),
        vec3(0.352, -1.0, 0.936),
        lightColor, 12.0
    );

    return result;
}


float spotVolume(
    vec3 p,
    vec3 lightPos,
    vec3 lightDir
)
{
    vec3 delta = p - lightPos;
    float distanceToLight = length(delta);

    float cone = dot(
        normalize(delta),
        normalize(lightDir)
    );

    float spot = smoothstep(0.8, 1.0, cone);

    float attenuation = exp(-0.06 * distanceToLight);

    return spot * attenuation;
}


vec3 volumetricStreetLights(
    vec3 Cam,
    vec3 rd,
    float maxDistance
)
{
    vec3 result = vec3(0.0);

    const int STEPS = 32;
    float stepSize = maxDistance / float(STEPS);

    vec3 lightColor = vec3(1.0, 0.78, 0.48);

    for(int i = 0; i < STEPS; i++)
    {
        float t = (float(i) + 0.5) * stepSize;
        vec3 samplePos = Cam + rd * t;

        float density = 0.0;

        density += spotVolume(
            samplePos,
            vec3(-12.0, 4.85, -16.0),
            vec3(0.0, -1.0, -1.0)
        );

        density += spotVolume(
            samplePos,
            vec3(14.294, 4.85, -20.354),
            vec3(-0.707, -1.0, 0.707)
        );

        density += spotVolume(
            samplePos,
            vec3(25.645, 4.85, -1.387),
            vec3(0.981, -1.0, -0.196)
        );

        density += spotVolume(
            samplePos,
            vec3(12.013, 4.85, 14.798),
            vec3(-0.659, -1.0, -0.752)
        );

        density += spotVolume(
            samplePos,
            vec3(-13.614, 4.85, 12.476),
            vec3(-0.242, -1.0, 0.970)
        );

        density += spotVolume(
            samplePos,
            vec3(-24.468, 4.85, -5.591),
            vec3(0.352, -1.0, 0.936)
        );

        result += lightColor * density * stepSize * 0.17;
    }

    return result;
}


vec3 carSpotLight(
    vec3 p,
    vec3 viewDir,
    vec3 normal,
    Surface s,
    vec3 lightPos,
    vec3 lightDir,
    vec3 lightColor,
    float intensity
)
{
    vec3 ld = p - lightPos;
    float distanceToLight = length(ld);
    vec3 l = -normalize(ld);

    float cone = dot(normalize(ld), normalize(lightDir));

    // Cone exclusivo dos faróis
    float spot = smoothstep(0.85, 0.97, cone);

    // Atenuação exclusiva dos faróis
    float attenuation = 1.0 / (
        1.0 + 0.15 * distanceToLight
        + 0.04 * distanceToLight * distanceToLight
    );

    float dif = max(dot(normal, l), 0.0);

    vec3 result = s.color * s.Kd * lightColor
                * dif * attenuation * spot * intensity;

    vec3 reflectDir = reflect(-l, normal);
    float spec = max(dot(viewDir, reflectDir), 0.0);

    result += s.Ks * lightColor
            * pow(spec, 5.0) * attenuation * spot * intensity;

    return result;
}


vec3 carHeadlights(
    vec3 p,
    vec3 viewDir,
    vec3 normal,
    Surface s
)
{
    vec3 color = vec3(1.0, 0.95, 0.82);
    vec3 result = vec3(0.0);

    // Farol esquerdo
    result += carSpotLight(
        p, viewDir, normal, s,
        vec3(-0.35, 0.45, -20.65),
        vec3(1.0, -0.12, 0.0),
        color, 12.0
    );

    // Farol direito
    result += carSpotLight(
        p, viewDir, normal, s,
        vec3(-0.35, 0.45, -19.35),
        vec3(1.0, -0.12, 0.0),
        color, 12.0
    );

    return result;
}