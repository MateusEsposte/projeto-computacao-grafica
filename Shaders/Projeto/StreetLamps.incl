
Surface lampPart(float d, vec3 color, float Ka, float Kd, float Ks)
{
    Surface s;
    s.d = d;
    s.color = color;
    s.Ka = Ka;
    s.Kd = Kd;
    s.Ks = Ks;
    return s;
}

// Constrói um poste individual.
// base = posição XZ do poste
// inward = direção do braço, apontando para a pista
Surface singleStreetLamp(vec3 p, vec2 base, vec2 inward)
{
    Surface result;

    // Posição da base no espaço 3D
    vec3 basePos = vec3(base.x, 0.0, base.y);

    // Ponta do braço direcionada para a pista
    vec2 headPos = base + inward * 0.8;

    // Base de concreto
    result = lampPart(
        boxRoundDist(
            p - (basePos + vec3(0.0, 0.12, 0.0)),
            vec3(0.22, 0.12, 0.22),
            0.04
        ),
        vec3(0.20, 0.20, 0.19),
        0.15, 0.65, 0.1
    );

    // Haste vertical
    Surface pole = lampPart(
        cylinderDist(
            p,
            basePos + vec3(0.0, 0.2, 0.0),
            basePos + vec3(0.0, 5.0, 0.0),
            0.075
        ),
        vec3(0.16, 0.17, 0.18),
        0.12, 0.7, 0.25
    );

    result = unionS(result, pole);

    // Braço horizontal
    Surface arm = lampPart(
        cylinderDist(
            p,
            basePos + vec3(0.0, 4.85, 0.0),
            vec3(headPos.x, 4.85, headPos.y),
            0.055
        ),
        vec3(0.16, 0.17, 0.18),
        0.12, 0.7, 0.25
    );

    result = unionS(result, arm);

    // Corpo da luminária
    Surface head = lampPart(
        boxRoundDist(
            p - vec3(headPos.x, 4.85, headPos.y),
            vec3(0.32, 0.09, 0.20),
            0.07
        ),
        vec3(0.85, 0.68, 0.38),
        0.45, 0.5, 0.15
    );

    result = unionS(result, head);

    return result;
}

// Conjunto de seis postes distribuídos pelo circuito
Surface streetLampsModel(vec3 p)
{
    Surface result = singleStreetLamp(
        p, vec2(-12.0, -15.2), vec2(0.0, -1.0)
    );

    result = unionS(result, singleStreetLamp(
        p, vec2(14.86, -20.92), vec2(-0.707, 0.707)
    ));

    result = unionS(result, singleStreetLamp(
        p, vec2(24.86, -1.23), vec2(0.981, -0.196)
    ));

    result = unionS(result, singleStreetLamp(
        p, vec2(12.54, 15.40), vec2(-0.659, -0.752)
    ));

    result = unionS(result, singleStreetLamp(
        p, vec2(-13.42, 11.70), vec2(-0.242, 0.970)
    ));

    result = unionS(result, singleStreetLamp(
        p, vec2(-24.75, -6.34), vec2(0.352, 0.936)
    ));

    return result;
}
