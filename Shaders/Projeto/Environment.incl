// Retorna:
// x = distancia quadrada ate o segmento
// y = distancia lateral com sinal
vec2 terrainSegmentData(vec3 p, vec2 a, vec2 b)
{
    vec2 q = p.xz - a;
    vec2 ba = b - a;

    float h = clamp(
        dot(q, ba) / dot(ba, ba),
        0.0,
        1.0
    );

    vec2 closest = a + ba * h;
    vec2 delta = p.xz - closest;

    float side = ba.x * delta.y - ba.y * delta.x;

    return vec2(dot(delta, delta), sign(side) * length(delta));
}


// Determina o lado mais proximo do percurso
float terrainSide(vec3 p)
{
    vec2 best = terrainSegmentData(
        p, vec2(-14.0, -20.0), vec2(0.0, -20.0)
    );

    vec2 candidate;

    candidate = terrainSegmentData(p, vec2(0.0, -20.0), vec2(10.0, -20.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(10.0, -20.0), vec2(18.0, -12.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(18.0, -12.0), vec2(22.0, -14.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(22.0, -14.0), vec2(28.0, -10.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(28.0, -10.0), vec2(30.0, 0.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(30.0, 0.0), vec2(24.0, 6.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(24.0, 6.0), vec2(16.0, 6.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(16.0, 6.0), vec2(0.0, 20.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(0.0, 20.0), vec2(-16.0, 16.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(-16.0, 16.0), vec2(-22.0, 12.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(-22.0, 12.0), vec2(-26.0, 6.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(-26.0, 6.0), vec2(-28.0, 0.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(-28.0, 0.0), vec2(-12.0, -6.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(-12.0, -6.0), vec2(-16.0, -12.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(-16.0, -12.0), vec2(-16.0, -16.0));
    if(candidate.x < best.x) best = candidate;

    candidate = terrainSegmentData(p, vec2(-16.0, -16.0), vec2(-14.0, -20.0));
    if(candidate.x < best.x) best = candidate;

    return best.y;
}


// Hash pseudoaleatorio
float terrainHash(vec2 p)
{
    return fract(
        sin(dot(p, vec2(127.1, 311.7))) * 43758.5453
    );
}


// Ruido de valor bidimensional
float terrainNoise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);

    // Interpolacao suave
    f = f * f * (3.0 - 2.0 * f);

    float a = terrainHash(i);
    float b = terrainHash(i + vec2(1.0, 0.0));
    float c = terrainHash(i + vec2(0.0, 1.0));
    float d = terrainHash(i + vec2(1.0, 1.0));

    float x1 = mix(a, b, f.x);
    float x2 = mix(c, d, f.x);

    return mix(x1, x2, f.y) * 2.0 - 1.0;
}


float terrainFBM(vec2 p)
{
    float n = 0.0;

    n += 0.65 * terrainNoise(p);
    n += 0.35 * terrainNoise(p * 2.3);

    return n;
}


float terrainHeight(vec3 p)
{
    float side = terrainSide(p);
    float distanceFromTrack = abs(side);

    float baseHeight;

    // Lado interno: mantém a encosta elevada
    if(side > 0.0)
    {
        baseHeight = 0.65 * max(distanceFromTrack - 6.0, 0.0);
    }
    // Lado externo: cria o barranco
    else
    {
        float d = max(distanceFromTrack - 6.0, 0.0);

        // Elevação inicial
        float rampUp = smoothstep(0.0, 4.0, d);

        // Queda depois da crista
        float rampDown = smoothstep(5.0, 12.0, d);

        baseHeight = 4.0 * rampUp * (1.0 - rampDown);

        // Depressão após o barranco
        baseHeight -= 0.35 * max(d - 12.0, 0.0);
    }

    // Relevo procedural já implementado
    float fade = smoothstep(6.0, 10.0, distanceFromTrack);

    float largeNoise = terrainNoise(p.xz * 0.12);
    float smallNoise = terrainFBM(p.xz * 0.45);

    float displacement =
        largeNoise * 0.22 +
        smallNoise * 0.07;

    return baseHeight + displacement * fade;
}


// Distancia ate o terreno
float terrainDistance(vec3 p)
{
    float height = terrainHeight(p);

    float terrainD = p.y - height;

    // Impede que o terreno invada a area da pista
    float trackBoundary = -trackDistance(p);

    return max(terrainD, trackBoundary);
}


// Modelo completo do ambiente
Surface environmentModel(vec3 p)
{
    Surface terrain;

    terrain.d = terrainDistance(p);

    terrain.color = vec3(0.16, 0.4, 0.13);

    terrain.Ka = 0.25;
    terrain.Kd = 0.55;
    terrain.Ks = 0.1;

    return terrain;
}