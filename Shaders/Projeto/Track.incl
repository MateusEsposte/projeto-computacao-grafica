// Distância entre um ponto e um segmento no plano XZ
float trackSegmentDist(vec3 p, vec2 a, vec2 b)
{
    vec2 q = p.xz - a;
    vec2 ba = b - a;

    float h = clamp(
        dot(q, ba) / dot(ba, ba),
        0.0,
        1.0
    );

    return length(q - ba * h) - 3.0;
}


// Define o circuito assimetrico e fechado
float trackDistance(vec3 p)
{
    float d = trackSegmentDist(
        p, vec2(-14.0, -20.0), vec2(0.0, -20.0)
    );

    d = min(d, trackSegmentDist(
        p, vec2(0.0, -20.0), vec2(10.0, -20.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(10.0, -20.0), vec2(18.0, -12.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(18.0, -12.0), vec2(22.0, -14.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(22.0, -14.0), vec2(28.0, -10.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(28.0, -10.0), vec2(30.0, 0.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(30.0, 0.0), vec2(24.0, 6.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(24.0, 6.0), vec2(16.0, 6.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(16.0, 6.0), vec2(0.0, 20.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(0.0, 20.0), vec2(-16.0, 16.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(-16.0, 16.0), vec2(-22.0, 12.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(-22.0, 12.0), vec2(-26.0, 6.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(-26.0, 6.0), vec2(-28.0, 0.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(-28.0, 0.0), vec2(-12.0, -6.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(-12.0, -6.0), vec2(-16.0, -12.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(-16.0, -12.0), vec2(-16.0, -16.0)
    ));

    d = min(d, trackSegmentDist(
        p, vec2(-16.0, -16.0), vec2(-14.0, -20.0)
    ));

    return d;
}

// Modelo completo da pista
Surface trackModel(vec3 p)
{
    Surface track;

    float roadD = trackDistance(p);

    // Espessura vertical do asfalto
    float verticalD = max(p.y, -0.12 - p.y);

    track.d = max(roadD, verticalD);

    track.color = vec3(0.12, 0.12, 0.12);
    track.Ka = 0.2;
    track.Kd = 0.4;
    track.Ks = 0.4;

    return track;
}