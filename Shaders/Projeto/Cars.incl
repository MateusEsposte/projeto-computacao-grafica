Surface carBody(vec3 p){
    Surface body;

    body.d = boxRoundDist(
        p - vec3(0.0, 0.35, 0.0),
        vec3(1.5, 0.25, 0.65),
        0.12
    );

    body.color = vec3(0.8, 0.05, 0.03);
    body.Ka = 0.2;
    body.Kd = 0.8;
    body.Ks = 0.4;

    return body;
}


Surface carCabin(vec3 p){
    Surface cabin;

    cabin.d = boxRoundDist(
        p - vec3(-0.2, 0.85, 0.0),
        vec3(0.75, 0.35, 0.52),
        0.12
    );

    cabin.color = vec3(0.12, 0.15, 0.18);
    cabin.Ka = 0.2;
    cabin.Kd = 0.6;
    cabin.Ks = 0.7;

    return cabin;
}


Surface carWheels(vec3 p){
    Surface wheels;

    float frontLeft = cylinderDist(
        p,
        vec3(1.0, 0.32, -0.92),
        vec3(1.0, 0.32, -0.52),
        0.32
    );

    float frontRight = cylinderDist(
        p,
        vec3(1.0, 0.32, 0.52),
        vec3(1.0, 0.32, 0.92),
        0.32
    );

    float rearLeft = cylinderDist(
        p,
        vec3(-1.0, 0.32, -0.92),
        vec3(-1.0, 0.32, -0.52),
        0.32
    );

    float rearRight = cylinderDist(
        p,
        vec3(-1.0, 0.32, 0.52),
        vec3(-1.0, 0.32, 0.92),
        0.32
    );

    wheels.d = min(
        min(frontLeft, frontRight),
        min(rearLeft, rearRight)
    );

    wheels.color = vec3(0.025, 0.025, 0.025);
    wheels.Ka = 0.2;
    wheels.Kd = 0.5;
    wheels.Ks = 0.3;

    return wheels;
}


Surface carHeadlights(vec3 p){
    Surface headlights;

    float left = boxRoundDist(
        p - vec3(1.43, 0.43, -0.43),
        vec3(0.10, 0.09, 0.13),
        0.05
    );

    float right = boxRoundDist(
        p - vec3(1.43, 0.43, 0.43),
        vec3(0.10, 0.09, 0.13),
        0.05
    );

    headlights.d = min(left, right);

    // Superfície amarelada dos faróis
    headlights.color = vec3(1.0, 0.85, 0.55);
    headlights.Ka = 1.0;
    headlights.Kd = 0.1;
    headlights.Ks = 0.2;

    return headlights;
}



Surface carModel(vec3 p){
    Surface car = carBody(p);

    car = unionS(car, carCabin(p));
    car = unionS(car, carWheels(p));
    car = unionS(car, carHeadlights(p));

    return car;
}